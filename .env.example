# Azure App Registration values (see README.md for how to get these)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# Must exactly match the redirect URI registered in Azure
# Local dev:
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Production (set this in Vercel's environment variables instead):
# MS_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
